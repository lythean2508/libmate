# Cấu hình mẫu Frontend LibMate (T36 / T46 — Không chứa bí mật)
# Chế độ kết nối: 'mock' (chạy độc lập với dữ liệu mẫu 100 đầu sách) hoặc 'api' (gọi FastAPI backend của Phạm Hiển)
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:8000
VITE_BORROW_LIMIT=3
VITE_LOAN_DAYS=14

# Chỉ máy chủ đọc các biến sau. Không đặt API key trong biến VITE_*.
# Lưu giá trị thật trong frontend/.env.local (đã được Git bỏ qua).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
